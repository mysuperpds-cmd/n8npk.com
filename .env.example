# Copy to .env.local and fill in real values. Never commit .env.local.
# On Hostinger, add these in the Node.js app's Environment Variables screen instead.

# Analytics (leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Lead forms -> email notification via Resend (required; this is what goes live first).
# TO: the inbox that receives enquiries (comma-separated for several).
# FROM: "N8NPK Leads <onboarding@resend.dev>" works straight away, but only for sending to
# the email address you signed up to Resend with. After verifying n8npk.com in Resend,
# use an address on the domain, e.g. "N8NPK Leads <leads@n8npk.com>".
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Optional add-on, later: also send each lead to an n8n webhook (Google Sheets, WhatsApp).
# Leave blank to keep email only. The secret must match the n8n Webhook node's Header Auth
# credential (header name: X-Webhook-Secret).
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
