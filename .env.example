# Copy to .env.local and fill in real values. Never commit .env.local.
# On Hostinger, add these in the Node.js app's Environment Variables screen instead.

# Analytics (leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Lead forms -> n8n webhook (primary). n8n saves each lead to Google Sheets and sends a WhatsApp alert.
# The secret must match the Header Auth credential on the n8n Webhook node (header name: X-Webhook-Secret).
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Backup email via Resend, used only when n8n or Google Sheets fails.
# FROM must use a domain verified in Resend, e.g. "N8NPK Leads <leads@n8npk.com>".
RESEND_API_KEY=
LEAD_BACKUP_EMAIL_TO=
LEAD_BACKUP_EMAIL_FROM=
